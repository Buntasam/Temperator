<Project Sdk="Microsoft.NET.Sdk">

  <!-- Temperator-Setup.exe : un seul fichier à télécharger, entièrement en C# (plus de PowerShell).
       .NET Framework 4.8 (déjà présent sur tout Windows 10/11) : se lance sans rien installer avant.
       Contient l'application (Temperator.zip), produite par build.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Temperator-Setup</AssemblyName>
    <RootNamespace>TemperatorSetup</RootNamespace>
    <ApplicationIcon>..\Temperator\Temperator.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <StartupObject>TemperatorSetup.Program</StartupObject>

    <Version>1.3.1</Version>
    <Product>Temperator</Product>
    <Company>Temperator</Company>
    <AssemblyTitle>Installeur de Temperator</AssemblyTitle>
    <Description>Installeur de Temperator</Description>
    <Copyright>Temperator</Copyright>

    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\payload</PayloadDir>
  </PropertyGroup>

  <!-- Release : demande les droits administrateur. Debug : sans élévation, pour /preview. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadDir)\Temperator.zip" LogicalName="Temperator.zip" />
    <Resource Include="..\Temperator\Temperator.ico" Link="Temperator.ico" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE.txt" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <Target Name="CheckPayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PayloadDir)\Temperator.zip')" Text="Temperator.zip absent de $(PayloadDir) : lance build.ps1 à la racine du dépôt." />
  </Target>

</Project>
