<Project Sdk="Microsoft.NET.Sdk">

  <!-- Temperator-Setup.exe : un seul fichier à télécharger.
       .NET Framework 4.8 (déjà présent sur tout Windows 10/11) : se lance sans rien installer avant.
       Contient l'installeur (Installer.ps1) et l'application (Temperator.zip), produits par build.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Temperator-Setup</AssemblyName>
    <RootNamespace>TemperatorSetup</RootNamespace>
    <ApplicationIcon>..\Temperator\Temperator.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>

    <Version>1.0.0</Version>
    <Product>Temperator</Product>
    <Company>Temperator</Company>
    <AssemblyTitle>Installeur de Temperator</AssemblyTitle>
    <Description>Installeur de Temperator</Description>
    <Copyright>Temperator</Copyright>

    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\payload</PayloadDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadDir)\Installer.ps1" LogicalName="Installer.ps1" />
    <EmbeddedResource Include="$(PayloadDir)\Temperator.zip" LogicalName="Temperator.zip" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <Target Name="CheckPayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PayloadDir)\Temperator.zip')" Text="Temperator.zip absent de $(PayloadDir) : lance build.ps1 à la racine du dépôt." />
  </Target>

</Project>
