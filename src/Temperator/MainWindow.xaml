<Window x:Class="Temperator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temperator" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowActivated="False" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Grid x:Name="Root" Margin="12">
    <Grid.LayoutTransform><ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>

    <!-- presque invisible (4/255) : le widget reste saisissable même avec un fond à 0 % -->
    <Border CornerRadius="14" Background="#04808080"/>

    <!-- fond (opaque ou verre teinté) + ombre, à part pour garder un texte net ; son opacité se règle à part -->
    <Border x:Name="Bg" CornerRadius="14" Background="{StaticResource CardBg}">
      <Border.Effect><DropShadowEffect x:Name="Shadow" ShadowDepth="3" BlurRadius="16" Opacity="0.5"/></Border.Effect>
    </Border>

    <!-- flammes quand c'est trop chaud (découpées aux coins arrondis) -->
    <Canvas x:Name="FireLayer"/>

    <Border x:Name="Card" CornerRadius="14" BorderThickness="1" Padding="14,10,14,10">
      <StackPanel x:Name="Body" Width="218">
        <DockPanel x:Name="Header" Margin="0,0,0,6">
          <Viewbox Width="13" Height="13" VerticalAlignment="Center">
            <Canvas Width="58" Height="58">
              <Path x:Name="LogoArc" Data="M 12.17,45.83 A 23.8,23.8 0 1 1 45.83,45.83" StrokeThickness="7.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse x:Name="LogoDot" Canvas.Left="22" Canvas.Top="22" Width="14" Height="14"/>
            </Canvas>
          </Viewbox>
          <Ellipse x:Name="Pulse" DockPanel.Dock="Right" Width="6" Height="6" VerticalAlignment="Center" Opacity="0.25"/>
          <TextBlock x:Name="Brand" Text="TEMPERATOR" Margin="7,0,0,0" FontFamily="{StaticResource TitleFont}" FontSize="10.5" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel x:Name="Rows"/>
        <StackPanel x:Name="Gauges" Orientation="Horizontal" HorizontalAlignment="Center" Margin="-3,2,-3,0" Visibility="Collapsed"/>
        <StackPanel x:Name="BarPanel" Orientation="Horizontal" Margin="0,0,-12,0" Visibility="Collapsed"/>
        <TextBlock x:Name="Notice" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,1" MaxWidth="250" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
