<Window x:Class="Temperator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temperator" Width="800" Height="640" MinWidth="640" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="Temperator.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="14" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Grid Margin="16">
    <Border CornerRadius="16" Background="{StaticResource CardBg}">
      <Border.Effect><DropShadowEffect ShadowDepth="6" BlurRadius="26" Opacity="0.55"/></Border.Effect>
    </Border>
    <Border CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <DockPanel>
        <!-- en-tête -->
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Background="#01FFFFFF" Margin="26,22,22,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Viewbox Width="36" Height="36" VerticalAlignment="Center">
            <Canvas Width="58" Height="58">
              <Path x:Name="LogoArc" Data="M 12.17,45.83 A 23.8,23.8 0 1 1 45.83,45.83" Stroke="{StaticResource Accent}" StrokeThickness="6.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse Canvas.Left="22.6" Canvas.Top="22.6" Width="12.8" Height="12.8" Fill="{StaticResource Text}"/>
            </Canvas>
          </Viewbox>
          <StackPanel Grid.Column="1" Margin="14,0,30,0" VerticalAlignment="Center">
            <TextBlock x:Name="Heading" FontFamily="{StaticResource TitleFont}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock x:Name="SubHeading" FontSize="12.5" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <TextBlock x:Name="CloseX" Grid.Column="1" Text="✕" FontSize="15" Foreground="{StaticResource Muted}" Cursor="Hand"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0" Padding="6,2"/>
        </Grid>

        <Grid Margin="18,0,8,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel x:Name="Nav" Margin="0,0,14,0"/>
          <Border Grid.Column="1" CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,16,14,16">
              <StackPanel x:Name="Page"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Window>
