<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Temperator</RootNamespace>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RollForward>LatestMajor</RollForward>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>

    <Version>1.3.1</Version>
    <Product>Temperator</Product>
    <Company>Temperator</Company>
    <Description>Températures et utilisation du PC, toujours à l'écran.</Description>
    <Copyright>Temperator</Copyright>
    <ApplicationIcon>Temperator.ico</ApplicationIcon>
    <!-- WPF : la gestion DPI par écran est déclarée dans app.manifest -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- Release : demande les droits administrateur (nécessaires pour lire les capteurs).
       Debug : se lance sans élévation, pratique pour développer. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Temperator.ico" />
  </ItemGroup>

</Project>
