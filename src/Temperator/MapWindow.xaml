<Window x:Class="Temperator.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan du PC – Temperator" Width="640" Height="760" MinWidth="440" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="Temperator.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="14" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Grid Margin="16">
    <Border CornerRadius="16" Background="{StaticResource CardBg}">
      <Border.Effect><DropShadowEffect ShadowDepth="6" BlurRadius="26" Opacity="0.55"/></Border.Effect>
    </Border>
    <Border CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <DockPanel>
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Background="#01FFFFFF" Margin="28,24,24,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Viewbox Width="40" Height="40" VerticalAlignment="Center">
            <Canvas Width="58" Height="58">
              <Path Data="M 12.17,45.83 A 23.8,23.8 0 1 1 45.83,45.83" Stroke="{StaticResource Accent}" StrokeThickness="6.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Effect><DropShadowEffect Color="#4ED8C0" ShadowDepth="0" BlurRadius="16" Opacity="0.8"/></Path.Effect>
              </Path>
              <Ellipse Canvas.Left="22.6" Canvas.Top="22.6" Width="12.8" Height="12.8" Fill="{StaticResource Text}"/>
            </Canvas>
          </Viewbox>
          <StackPanel Grid.Column="1" Margin="16,0,30,0" VerticalAlignment="Center">
            <TextBlock Text="Plan du PC" FontFamily="{StaticResource TitleFont}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock x:Name="Machine" FontSize="12.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock x:Name="CloseX" Grid.Column="1" Text="✕" FontSize="15" Foreground="{StaticResource Muted}" Cursor="Hand"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0" Padding="6,2"/>
        </Grid>

        <Grid>
          <TextBlock x:Name="Empty" Text="Lecture des capteurs…" FontSize="13" Foreground="{StaticResource Muted}" Margin="28,0" Visibility="Collapsed"/>
          <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,16" Padding="28,0,18,0">
            <ItemsControl x:Name="List">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Visibility="{Binding Visibility}" Margin="0,0,0,12" Padding="16,13,16,12" CornerRadius="12" Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,6">
                        <Border CornerRadius="6" Padding="7,1,7,2" Background="#224ED8C0" BorderBrush="#554ED8C0" BorderThickness="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Kind}" FontFamily="{StaticResource TitleFont}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding Visibility}">
                              <TextBlock Text="{Binding Title}" FontFamily="{StaticResource TitleFont}" FontSize="10.5" FontWeight="Bold"
                                         Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                              <ItemsControl ItemsSource="{Binding Sensors}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <DockPanel Margin="0,1,18,1" Visibility="{Binding Visibility}">
                                      <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="12.5" FontWeight="SemiBold"/>
                                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource Soft}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    </DockPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Window>
